# --- LLM (reasoning engine for the agent) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Swytchcode CLI ---
# Use the CLI installed by `npx swytchcode` or the `swytchcode` binary on PATH.
# Swytchcode stores/refreshes the service credentials itself; do not add raw
# Telegram/Slack/Notion/Resend secret keys here.
SWYTCHCODE_CLI=swytchcode
#SWYTCHCODE_CLI="npx swytchcode"

# --- Demo/target config (dummy data is fine) ---
TELEGRAM_CHAT_ID=your_test_chat_id
SLACK_CHANNEL=#community-updates
NOTION_DATABASE_ID=your_notion_db_id
RESEND_FROM_EMAIL=agent@yourdomain.dev
RESEND_TO_EMAIL=lead@yourdomain.dev
